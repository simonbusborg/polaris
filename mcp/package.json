{
  "name": "polestar-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for Polestar, built on the same flow as the Polaris menu bar app",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "bin": {
    "polestar-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
