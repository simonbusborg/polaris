# Polestar ID credentials (the same account you use in the Polestar app).
POLESTAR_EMAIL=you@example.com
POLESTAR_PASSWORD=

# Optional. With several cars on the account the first one is used unless
# you pin a VIN here.
POLESTAR_VIN=

# Optional. Where the refresh token is cached. Defaults to
# $XDG_STATE_HOME/polestar-mcp/tokens.json (~/.local/state/polestar-mcp/).
# Keep it outside the repo.
# POLESTAR_TOKEN_CACHE=
